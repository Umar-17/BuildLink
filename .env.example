# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or self-hosted PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/databasename?sslmode=require"

# Cryptographic Secret for Signing Auth Session Cookies (minimum 16 characters)
SESSION_SECRET="replace-with-a-secure-random-secret-key-at-least-16-chars"

# Optional Initial Administrator Credentials for Seeding (npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
